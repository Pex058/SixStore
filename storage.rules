rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Leitura de imagens pública para a vitrine
    // Upload/Deleção de fotos restritos ao administrador autenticado
    match /produtos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
